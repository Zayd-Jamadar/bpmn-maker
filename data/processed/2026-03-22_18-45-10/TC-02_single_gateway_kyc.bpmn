<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://sop-bpmn/process">
  <process id="Process_1" isExecutable="false">
    <startEvent id="start_1" name="Process started">
      <outgoing>flow_1</outgoing>
    </startEvent>
    <task id="task_1" name="Receive the new customer application form and supporting identity documents from the front desk.">
      <incoming>flow_1</incoming>
      <outgoing>flow_2</outgoing>
    </task>
    <task id="task_2" name="Enter the customer details into the KYC screening platform (OmniKYC).">
      <incoming>flow_2</incoming>
      <outgoing>flow_3</outgoing>
    </task>
    <task id="task_3" name="Run the automated identity verification check against government ID database.">
      <incoming>flow_3</incoming>
      <outgoing>flow_4</outgoing>
    </task>
    <task id="task_4" name="Review the OmniKYC verification result.">
      <incoming>flow_4</incoming>
      <outgoing>flow_5</outgoing>
    </task>
    <exclusiveGateway id="gw_1" name="Check if the KYC verification is complete and passed." gatewayDirection="Diverging">
      <incoming>flow_5</incoming>
      <outgoing>flow_6</outgoing>
      <outgoing>flow_7</outgoing>
    </exclusiveGateway>
    <task id="task_5" name="mark the customer record as KYC Approved in the core banking system and proceed to step 9.">
      <incoming>flow_6</incoming>
      <outgoing>flow_8</outgoing>
    </task>
    <task id="task_6" name="generate a KYC deficiency notice and send it to the customer via registered email, requesting the missing documents. Place the application on hold.">
      <incoming>flow_7</incoming>
      <outgoing>flow_9</outgoing>
    </task>
    <task id="task_7" name="Notify the Relationship Manager assigned to the account that KYC review is complete.">
      <incoming>flow_9</incoming>
      <outgoing>flow_10</outgoing>
    </task>
    <task id="task_8" name="File all KYC documents in the customer's digital record in the Document Management System (DMS).">
      <incoming>flow_8</incoming>
      <incoming>flow_10</incoming>
      <outgoing>flow_11</outgoing>
    </task>
    <endEvent id="end_1" name="Process complete">
      <incoming>flow_11</incoming>
    </endEvent>
    <sequenceFlow id="flow_1" name="" sourceRef="start_1" targetRef="task_1" />
    <sequenceFlow id="flow_2" name="" sourceRef="task_1" targetRef="task_2" />
    <sequenceFlow id="flow_3" name="" sourceRef="task_2" targetRef="task_3" />
    <sequenceFlow id="flow_4" name="" sourceRef="task_3" targetRef="task_4" />
    <sequenceFlow id="flow_5" name="" sourceRef="task_4" targetRef="gw_1" />
    <sequenceFlow id="flow_6" name="Yes" sourceRef="gw_1" targetRef="task_5" />
    <sequenceFlow id="flow_7" name="No" sourceRef="gw_1" targetRef="task_6" />
    <sequenceFlow id="flow_8" name="" sourceRef="task_5" targetRef="task_8" />
    <sequenceFlow id="flow_9" name="" sourceRef="task_6" targetRef="task_7" />
    <sequenceFlow id="flow_10" name="" sourceRef="task_7" targetRef="task_8" />
    <sequenceFlow id="flow_11" name="" sourceRef="task_8" targetRef="end_1" />
  </process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="Shape_start_1" bpmnElement="start_1">
        <dc:Bounds x="60" y="217" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_task_1" bpmnElement="task_1">
        <dc:Bounds x="240" y="200" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_task_2" bpmnElement="task_2">
        <dc:Bounds x="420" y="200" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_task_3" bpmnElement="task_3">
        <dc:Bounds x="600" y="200" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_task_4" bpmnElement="task_4">
        <dc:Bounds x="780" y="200" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_gw_1" bpmnElement="gw_1">
        <dc:Bounds x="960" y="200" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_task_5" bpmnElement="task_5">
        <dc:Bounds x="1140" y="80" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_task_6" bpmnElement="task_6">
        <dc:Bounds x="1140" y="320" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_task_7" bpmnElement="task_7">
        <dc:Bounds x="1500" y="200" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_task_8" bpmnElement="task_8">
        <dc:Bounds x="1680" y="200" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_end_1" bpmnElement="end_1">
        <dc:Bounds x="1860" y="217" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_flow_1" bpmnElement="flow_1">
        <di:waypoint x="96" y="235" />
        <di:waypoint x="240" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_2" bpmnElement="flow_2">
        <di:waypoint x="380" y="235" />
        <di:waypoint x="420" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_3" bpmnElement="flow_3">
        <di:waypoint x="560" y="235" />
        <di:waypoint x="600" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_4" bpmnElement="flow_4">
        <di:waypoint x="740" y="235" />
        <di:waypoint x="780" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_5" bpmnElement="flow_5">
        <di:waypoint x="920" y="235" />
        <di:waypoint x="960" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_6" bpmnElement="flow_6">
        <di:waypoint x="1010" y="225" />
        <di:waypoint x="1140" y="115" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_7" bpmnElement="flow_7">
        <di:waypoint x="1010" y="225" />
        <di:waypoint x="1140" y="355" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_8" bpmnElement="flow_8">
        <di:waypoint x="1280" y="115" />
        <di:waypoint x="1680" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_9" bpmnElement="flow_9">
        <di:waypoint x="1280" y="355" />
        <di:waypoint x="1500" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_10" bpmnElement="flow_10">
        <di:waypoint x="1640" y="235" />
        <di:waypoint x="1680" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_11" bpmnElement="flow_11">
        <di:waypoint x="1820" y="235" />
        <di:waypoint x="1860" y="235" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>